{
  "name": "lagoinha-kids",
  "account_id": "c799ce6344d15b7604a9b3717eab0aa3",
  "main": "deploy/cloudflare/worker.mjs",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/download/*",
      "/downloads/*",
      "/lagoinha-kids.apk",
      "/app-release.json",
      "/mobile-release.json",
      "/sw.js",
      "/index.html",
      "/systems.html",
      "/"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lagoinha-kids-db",
      "database_id": "b978290d-50e4-4dfc-86dd-d6207b57ea92"
    }
  ]
}
